{
  "manifest_version": 3,
  "name": "block somebody",
  "short_name": "block s.b.",
  "version": "0.1.17",
  "description": "为选定的 X 评论展示附和概率，自动屏蔽明确支持者，支持手动屏蔽、历史撤销和白名单。",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "cookies"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.typesafe.ai/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "block s.b. · 历史、白名单与设置",
    "default_popup": "src/manager/manager.html?popup=1",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "20": "assets/icons/icon-20.png",
      "24": "assets/icons/icon-24.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "64": "assets/icons/icon-64.png"
    }
  },
  "options_page": "src/manager/manager.html",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/content/page-observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/content/x-client.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/manager/manager.html",
        "src/manager/manager.js",
        "src/manager/manager.css",
        "src/content/overlay.css",
        "assets/brand.svg"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https:; frame-src 'self'"
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
